# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / Cloud SQL Connection Variables (App User - Read/Write)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="hostgraber_portal"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_USER_PASSWORD"

# PostgreSQL / Cloud SQL Admin Variables (Schema Migrations via Drizzle Kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Server Port (defaults to 3000)
PORT="3000"
